# EncoreTransport core
APP_TIMEZONE=America/Santo_Domingo
BOOKING_HOLD_MINUTES=15
ENCORE_CURRENCY=DOP
DEMO_MODE=false

# TomTom
MAP_PROVIDER=tomtom
TOMTOM_API_KEY=
TOMTOM_SEARCH_BASE_URL=https://api.tomtom.com/search/2
TOMTOM_ROUTING_BASE_URL=https://api.tomtom.com/routing/1
TOMTOM_TIMEOUT_SECONDS=10
TOMTOM_COUNTRY_SET=DO
TOMTOM_LANGUAGE=es-DO

# Payments
PAYMENT_GATEWAY=unconfigured
POWERTRANZ_API_URL=
POWERTRANZ_MERCHANT_ID=
POWERTRANZ_API_KEY=

# Notifications / realtime
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

# Swagger / OpenAPI
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://127.0.0.1:8000
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=true
