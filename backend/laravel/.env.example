APP_NAME="Encore Transport"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Santo_Domingo
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_DO

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Production target: MySQL 8+
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=encoretransport
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@encoretransport.local"
MAIL_FROM_NAME="${APP_NAME}"

ENCORE_CURRENCY=DOP
ENCORE_BOOKING_HOLD_MINUTES=15
ENCORE_PAYMENT_GATEWAY=unconfigured

MAP_PROVIDER=tomtom
TOMTOM_API_KEY=
TOMTOM_SEARCH_BASE_URL=https://api.tomtom.com/search/2
TOMTOM_ROUTING_BASE_URL=https://api.tomtom.com/routing/1
TOMTOM_LANGUAGE=es-ES
TOMTOM_COUNTRY_SET=DO
TOMTOM_TIMEOUT=15

# Swagger development UI
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://127.0.0.1:8000

# External providers intentionally blank until real credentials/docs exist
POWERTRANZ_MERCHANT_ID=
POWERTRANZ_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
