{
  "name": "encore-transport",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "dev:website": "node server.mjs",
    "dev:passenger": "npm --workspace @encore/passenger run dev",
    "dev:operations": "node server.mjs",
    "mobile:passenger": "npm --workspace @encore/passenger-mobile run dev",
    "mobile:driver": "npm --workspace @encore/driver-mobile run dev",
    "build:passenger": "npm --workspace @encore/passenger run build",
    "test": "node tests/business-rules.test.mjs",
    "check": "node tests/business-rules.test.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
