{
  "name": "encore-transport",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev:website": "node --env-file-if-exists=.env server.mjs",
    "dev:passenger": "npm --workspace @encore/passenger run dev",
    "dev:operations": "node --env-file-if-exists=.env server.mjs",
    "mobile:passenger": "npm --workspace @encore/passenger-mobile run dev",
    "mobile:driver": "npm --workspace @encore/driver-mobile run dev",
    "build:passenger": "npm --workspace @encore/passenger run build",
    "preview:passenger": "npm --workspace @encore/passenger run preview",
    "typecheck:api-client": "npm --workspace @encore/api-client run typecheck",
    "typecheck:passenger": "npm --workspace @encore/passenger run typecheck",
    "typecheck:passenger-mobile": "npm --workspace @encore/passenger-mobile run typecheck",
    "typecheck:driver-mobile": "npm --workspace @encore/driver-mobile run typecheck",
    "test:business": "node tests/business-rules.test.mjs",
    "test:hardcode": "node tests/production-hardcode.test.mjs",
    "test:server": "node tests/server-routing.test.mjs",
    "test:dashboard-permissions": "node tests/dashboard-permission-contract.test.mjs",
    "test:report-exports": "node tests/admin-report-exports.test.mjs",
    "test:report-charts": "node tests/admin-report-charts.test.mjs",
    "test:real-map": "node tests/real-map-contract.test.mjs",
    "test:map-runtime": "node tests/map-runtime-contract.test.mjs",
    "test:seat-layout": "node tests/seat-layout-visual-contract.test.mjs",
    "test:ux-regression": "node tests/ux-regression.test.mjs",
    "test:native-gps": "node tests/native-gps-contract.test.mjs",
    "test:premium-design": "node tests/premium-design-contract.test.mjs",
    "test:premium-responsive": "node tests/premium-responsive-contract.test.mjs",
    "test:seo": "node tests/seo-contract.test.mjs",
    "test:visual-contract": "node tests/visual-contract.test.mjs",
    "test:performance-browser": "node tests/performance-browser.test.mjs",
    "test:visual-browser": "node tests/visual-browser.test.mjs",
    "test": "npm run test:business && npm run test:hardcode && npm run test:server && npm run test:dashboard-permissions && npm run test:report-exports && npm run test:report-charts && npm run test:real-map && npm run test:map-runtime && npm run test:seat-layout && npm run test:ux-regression && npm run test:native-gps && npm run test:premium-design && npm run test:premium-responsive && npm run test:seo && npm run test:visual-contract && npm run test:performance-browser",
    "check": "npm run test",
    "validate:frontend": "npm run test && npm run typecheck:api-client && npm run typecheck:passenger && npm run build:passenger",
    "validate:mobile": "npm run test:native-gps && npm run typecheck:passenger-mobile && npm run typecheck:driver-mobile",
    "validate:backend": "cd backend/laravel && php artisan optimize:clear && php artisan route:list && php artisan migrate:status && php artisan l5-swagger:generate && php artisan test",
    "validate:local": "npm run validate:frontend && npm run validate:mobile && npm run validate:backend"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
