[Unit]
Description=EncoreTransport Laravel scheduled tasks
After=network-online.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/encoretransport/current/backend/laravel
EnvironmentFile=-/etc/encoretransport/laravel.env
ExecStart=/usr/bin/php artisan schedule:run
PrivateTmp=true
ProtectHome=true
