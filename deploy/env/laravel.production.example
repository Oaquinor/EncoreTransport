# Plantilla de referencia. Copiar a backend/laravel/.env en el VPS y sustituir
# cada valor CHANGE_ME antes de ejecutar el preflight.

APP_NAME="Encore Transport"
APP_ENV=production
APP_KEY=base64:CHANGE_ME_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE=America/Guyana
APP_URL=https://YOUR_PRODUCTION_DOMAIN
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=notice

DB_CONNECTION=mysql
DB_HOST=CHANGE_ME_PRIVATE_DB_HOST
DB_PORT=3306
DB_DATABASE=CHANGE_ME_DATABASE
DB_USERNAME=CHANGE_ME_DATABASE_USER
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=YOUR_PRODUCTION_DOMAIN
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Correo real solo después de validar el proveedor y el remitente.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@YOUR_PRODUCTION_DOMAIN
MAIL_FROM_NAME="${APP_NAME}"
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

ENCORE_COUNTRY=Guyana
ENCORE_CURRENCY=GYD
ENCORE_LOCALE=en-GY
ENCORE_TIMEZONE=America/Guyana
ENCORE_BOOKING_HOLD_MINUTES=15
ENCORE_PAYMENT_GATEWAY=unconfigured

MAP_PROVIDER=tomtom
TOMTOM_API_KEY=CHANGE_ME_TOMTOM_KEY
TOMTOM_SEARCH_BASE_URL=https://api.tomtom.com/search/2
TOMTOM_ROUTING_BASE_URL=https://api.tomtom.com/routing/1
TOMTOM_DISPLAY_BASE_URL=https://api.tomtom.com
TOMTOM_LANGUAGE=en-GB
TOMTOM_COUNTRY_SET=GY
TOMTOM_VIEW=Unified
TOMTOM_MAP_STYLE=street-light
TOMTOM_TILE_SIZE=256
TOMTOM_TRAVEL_MODE=car
TOMTOM_TIMEOUT=15
TOMTOM_TILE_CACHE_ENABLED=true
TOMTOM_TILE_CACHE_DEFAULT_TTL=300
TOMTOM_TILE_CACHE_MAX_TTL=3600

L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_PUBLIC=false

# Permanecer vacíos hasta la aceptación sandbox/webhook.
POWERTRANZ_MERCHANT_ID=
POWERTRANZ_API_KEY=
POWERTRANZ_BASE_URL=
POWERTRANZ_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=
