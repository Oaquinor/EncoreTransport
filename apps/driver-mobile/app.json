{
  "expo": {
    "name": "Encore Driver",
    "slug": "encore-driver",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "encore-driver",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Encore Driver to share your location while you are working an assigned trip."
        }
      ]
    ]
  }
}
